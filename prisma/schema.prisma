generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              Int        @id @default(autoincrement())
  rol             String
  estado          String     @default("aprobada")
  nombre          String
  email           String     @unique
  contrasena      String
  dni             String     @unique
  matricula       String?    @unique
  especialidad    String?
  hospital        String?
  fechaNacimiento DateTime?
  direccion       String?
  latitud         Float?
  longitud        Float?
  pesoKg          Float?
  alergias        Alergia[]
  codigosQr       CodigoQr[]
  createdAt       DateTime   @default(now())

  atencionesRecibidas  Atencion[] @relation("PacienteAtendido")
  atencionesRealizadas Atencion[] @relation("MedicoQueAtiende")
}

model Alergia {
  id         Int      @id @default(autoincrement())
  nombre     String
  pacienteId Int
  paciente   Usuario  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model CodigoQr {
  id         Int      @id @default(autoincrement())
  codigo     String   @unique
  pacienteId Int
  paciente   Usuario  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  venceEn    DateTime
  createdAt  DateTime @default(now())
}

model Matricula {
  id           Int      @id @default(autoincrement())
  matricula    String   @unique
  nombre       String
  dni          String
  especialidad String
  createdAt    DateTime @default(now())
}

model Categoria {
  id           Int           @id @default(autoincrement())
  clave        String        @unique
  nombre       String
  nota         String?
  orden        Int
  medicamentos Medicamento[]
  createdAt    DateTime      @default(now())
}

model Medicamento {
  id              Int          @id @default(autoincrement())
  categoriaId     Int
  categoria       Categoria    @relation(fields: [categoriaId], references: [id])
  nombre          String
  principioActivo String       @default("")
  viaCima         String       @default("")
  via             String       @default("")
  esCritico       Boolean      @default(false)
  activo          Boolean      @default(true)
  orden           Int
  filas           FilaLibro[]
  dosis           Dosis[]
  createdAt       DateTime     @default(now())
}

model FilaLibro {
  id            Int         @id @default(autoincrement())
  medicamentoId Int
  medicamento   Medicamento @relation(fields: [medicamentoId], references: [id], onDelete: Cascade)
  peso          Float
  dosisKg       String      @default("")
  indicar       String      @default("")
  preparar      String      @default("")
  administrar   String      @default("")
  alerta        String      @default("")
  detalle       String      @default("")
  cantidadMin   Float
  cantidadMax   Float
  unidad        String
  correccion    String      @default("")

  @@unique([medicamentoId, peso])
  @@index([peso])
}

model Atencion {
  id         Int      @id @default(autoincrement())
  pacienteId Int
  paciente   Usuario  @relation("PacienteAtendido", fields: [pacienteId], references: [id])
  medicoId   Int
  medico     Usuario  @relation("MedicoQueAtiende", fields: [medicoId], references: [id])
  lugar      String
  pesoKg     Float
  fecha      DateTime @default(now())
  dosis      Dosis[]
  createdAt  DateTime @default(now())
}

model Dosis {
  id            Int         @id @default(autoincrement())
  atencionId    Int
  atencion      Atencion    @relation(fields: [atencionId], references: [id], onDelete: Cascade)
  medicamentoId Int
  medicamento   Medicamento @relation(fields: [medicamentoId], references: [id])
  nombre        String
  via           String
  cantidad      Float
  unidad        String
  detalle       String      @default("")
  hora          DateTime
  createdAt     DateTime    @default(now())
}
