generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Una sola tabla para los tres tipos de cuenta (rol: medico, paciente o admin).
// Los campos que no corresponden al rol quedan en null.
model Usuario {
  id              Int        @id @default(autoincrement())
  rol             String
  // pendiente (medico esperando aprobacion), aprobada, rechazada o baja (el admin lo dio de baja; no se borra)
  estado          String     @default("aprobada")
  nombre          String
  email           String     @unique
  contrasena      String
  dni             String     @unique
  // Solo medico
  matricula       String?    @unique
  especialidad    String?
  hospital        String?
  // Solo paciente
  fechaNacimiento DateTime?
  direccion       String?
  latitud         Float?
  longitud        Float?
  pesoKg          Float?
  alergias        Alergia[]
  codigosQr       CodigoQr[]
  createdAt       DateTime   @default(now())

  atencionesRecibidas  Atencion[] @relation("PacienteAtendido")
  atencionesRealizadas Atencion[] @relation("MedicoQueAtiende")
}

model Alergia {
  id         Int      @id @default(autoincrement())
  nombre     String
  pacienteId Int
  paciente   Usuario  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

// Codigo que muestra el QR del paciente: es aleatorio y vence en pocos minutos.
model CodigoQr {
  id         Int      @id @default(autoincrement())
  codigo     String   @unique
  pacienteId Int
  paciente   Usuario  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  venceEn    DateTime
  createdAt  DateTime @default(now())
}

// Registro oficial de matriculas contra el que se verifica a los medicos.
model Matricula {
  id           Int      @id @default(autoincrement())
  matricula    String   @unique
  nombre       String
  dni          String
  especialidad String
  createdAt    DateTime @default(now())
}

// Secciones del libro (anafilaxia, resucitacion, intubacion, etc.).
model Categoria {
  id           Int           @id @default(autoincrement())
  clave        String        @unique
  nombre       String
  nota         String?
  orden        Int
  medicamentos Medicamento[]
  createdAt    DateTime      @default(now())
}

// Cada indicacion de las tablas por peso del libro (un medicamento, un dispositivo, una correccion de electrolitos).
// Las filas viejas del catalogo anterior quedan con activo = false para no perder el historial de atenciones.
model Medicamento {
  id              Int          @id @default(autoincrement())
  categoriaId     Int
  categoria       Categoria    @relation(fields: [categoriaId], references: [id])
  nombre          String
  principioActivo String       @default("")
  viaCima         String       @default("")
  via             String       @default("")
  esCritico       Boolean      @default(false)
  activo          Boolean      @default(true)
  orden           Int
  filas           FilaLibro[]
  dosis           Dosis[]
  createdAt       DateTime     @default(now())
}

// Lo que el libro imprime para un medicamento en la tabla de un peso (una fila por medicamento y peso).
// Los textos se guardan tal cual figuran. cantidadMin y cantidadMax son la cantidad que se registra al suministrar
// (iguales si es un solo valor): la dosis, o la cantidad principal en lo que no es una dosis unica
// (infusiones, correcciones de electrolitos, descarga electrica, tubo endotraqueal).
model FilaLibro {
  id            Int         @id @default(autoincrement())
  medicamentoId Int
  medicamento   Medicamento @relation(fields: [medicamentoId], references: [id], onDelete: Cascade)
  peso          Float
  dosisKg       String      @default("")
  indicar       String      @default("")
  preparar      String      @default("")
  administrar   String      @default("")
  alerta        String      @default("")
  detalle       String      @default("")
  cantidadMin   Float
  cantidadMax   Float
  unidad        String
  correccion    String      @default("")

  @@unique([medicamentoId, peso])
  @@index([peso])
}

model Atencion {
  id         Int      @id @default(autoincrement())
  pacienteId Int
  paciente   Usuario  @relation("PacienteAtendido", fields: [pacienteId], references: [id])
  medicoId   Int
  medico     Usuario  @relation("MedicoQueAtiende", fields: [medicoId], references: [id])
  lugar      String
  pesoKg     Float
  fecha      DateTime @default(now())
  dosis      Dosis[]
  createdAt  DateTime @default(now())
}

// Una dosis suministrada. Guarda el nombre, la via y la unidad tal como se dieron.
model Dosis {
  id            Int         @id @default(autoincrement())
  atencionId    Int
  atencion      Atencion    @relation(fields: [atencionId], references: [id], onDelete: Cascade)
  medicamentoId Int
  medicamento   Medicamento @relation(fields: [medicamentoId], references: [id])
  nombre        String
  via           String
  cantidad      Float
  unidad        String
  detalle       String      @default("")
  hora          DateTime
  createdAt     DateTime    @default(now())
}
